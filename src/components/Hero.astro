---
---

<section id="hero" class="relative w-full h-screen overflow-hidden flex items-center justify-center">
  <!-- Background Video -->
  <video
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/innen-dunkel.jpeg"
    style="filter: blur(2px) brightness(0.55);"
  >
    <source src="/video/hero.mp4" type="video/mp4" />
  </video>

  <!-- Gradient Overlay -->
  <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(26,17,12,0.55) 0%, rgba(26,17,12,0.75) 100%);"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 flex flex-col items-center">
    <!-- Logo -->
    <div class="hero-logo">
      <img
        src="/images/logo.png"
        alt="ATESH Grill & Restaurant"
        class="w-80 md:w-[26rem] mx-auto"
        style="filter: drop-shadow(0 4px 24px rgba(196,149,58,0.2));"
      />
    </div>

    <!-- Subtitle -->
    <p class="hero-sub mt-5 text-[#B8A99A] text-sm md:text-base tracking-[0.35em] uppercase font-['DM_Sans']">
      Modern Turkish · Steakhouse · Bremen
    </p>

    <!-- Slogan -->
    <p class="hero-slogan mt-7 font-['Playfair_Display'] italic text-[#C4953A] text-2xl md:text-3xl">
      Taste the difference
    </p>

    <!-- CTA -->
    <div class="hero-cta mt-10 flex flex-col sm:flex-row gap-4 items-center">
      <a
        href="#reservation"
        class="inline-block border border-[#C4953A] text-[#C4953A] text-sm tracking-[0.2em] uppercase font-semibold
          px-10 py-4 transition-all duration-300 hover:bg-[#C4953A] hover:text-[#1A110C]"
      >
        Tisch reservieren
      </a>
      <a
        href="https://ateshgrillrestaurant.online-karte.com/ateshgrillrestaurant"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border border-[#C41E24] text-[#C41E24] text-sm tracking-[0.2em] uppercase font-semibold
          px-10 py-4 transition-all duration-300 hover:bg-[#C41E24] hover:text-[#F5F0EB]"
      >
        Online Bestellen
      </a>
      <div class="w-full sm:w-auto flex justify-center">
        <script is:inline src="https://tech.bon-bon.de/banner/assets/bonbon-bb2_ml.js"></script>
        <script is:inline>
          bonbon.addBanner(
            'https://www.bon-bon.de/gutschein/atesh-grill-restaurant/',
            // BON BON prepends the hash to these hex values.
            '1A110C',
            'C4953A'
          );
        </script>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 hero-scroll">
    <svg class="text-[#B8A99A] opacity-60" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  :global(body:has(.bonbon_container)) {
    --atesh-voucher-edge: 1.75rem;
    --atesh-voucher-gap: 0.5rem;
    --atesh-voucher-width: min(240px, calc(100vw - var(--atesh-voucher-edge) - var(--atesh-voucher-edge) - 52px - var(--atesh-voucher-gap)));
  }

  /* BON BON appends its widget to body, outside Astro's scoped markup. */
  :global(body .bonbon_container) {
    --atesh-voucher-bottom: calc(var(--atesh-voucher-edge) + 52px + 1rem);
    bottom: calc(var(--atesh-voucher-edge) + 2px);
    right: var(--atesh-voucher-edge);
    left: auto;
    transform: none;
    padding-right: 0;
    width: var(--atesh-voucher-width);
  }

  :global(body .bonbon_container .bonbon_ibc) {
    margin: 0;
  }

  /* Use the promotion trigger's existing reveal state and animation timing. */
  :global(body .bonbon_container .bonbon_ibc:not(.slide-up)) {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(body:has(#promo-trigger.visible) .bonbon_container .bonbon_ibc:not(.slide-up)) {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  :global(body:has(.bonbon_container) #promo-trigger) {
    bottom: var(--atesh-voucher-edge);
    right: calc(var(--atesh-voucher-edge) + var(--atesh-voucher-width) + var(--atesh-voucher-gap));
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s,
      right 0.5s ease-out, bottom 0.5s ease-out;
  }

  /* BON BON toggles slide-up itself; keep the circle next to the open popup. */
  :global(body:has(.bonbon_container .bonbon_puc.slide-up) #promo-trigger) {
    right: var(--atesh-voucher-edge);
    bottom: calc(var(--atesh-voucher-edge) + 1rem - var(--atesh-voucher-gap));
  }

  :global(body .bonbon_container .bonbon_puc) {
    position: absolute;
    /* Preserve the popup's previous position above the floating controls. */
    bottom: calc(52px + 1rem - 2px);
    right: 0;
    left: auto;
    width: min(320px, calc(100vw - var(--atesh-voucher-edge) - var(--atesh-voucher-edge)));
    max-height: calc(100dvh - var(--atesh-voucher-bottom) - 1rem);
    overflow-y: auto;
    transform: translateY(100%);
  }

  :global(body .bonbon_container .bonbon_puc.slide-up) {
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    :global(body:has(.bonbon_container)) {
      --atesh-voucher-edge: 1.25rem;
    }
  }
</style>
